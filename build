#!/bin/bash

ASM_DIR="/Users/msw/dev/8085-Assembler/"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$SCRIPT_DIR" || exit 1
MAME_ROM_DIR="$SCRIPT_DIR/upstream/mame/roms"
ROM_SIZE=2048

if [ -z "$1" ]; then
    echo "Usage: $0 <source-game>"
    exit 1
fi

src_filename=$(basename -- "$1")
src_filename="${src_filename%.*}"
if [ -n "$2" ]; then
    echo "build now chooses its MAME target from rom_count; do not pass a destination"
    exit 1
fi

config=$(python3 "$SCRIPT_DIR/rom_config.py" "$src_filename") || exit $?
IFS=$'\t' read -r ROM_COUNT MAME_SYSTEM MAME_ROM_PREFIX SRC_ROM_PREFIX <<< "$config"
cd "$src_filename" || exit 1
FILE="$src_filename.asm"
ONE_FILE="$src_filename.bin"
if [ ! -f "$FILE" ]; then
    echo "File $FILE not found!"
    exit 1
fi

python3 "$ASM_DIR/src/assembler.py" "$FILE" -b -o "$ONE_FILE"
if [ $? -ne 0 ]; then
    echo "assembler failed"
    exit 1
fi

EXPECTED_SIZE=$((ROM_SIZE * ROM_COUNT))
FILESIZE=$(wc -c < "$ONE_FILE")
if [ "$FILESIZE" -ne "$EXPECTED_SIZE" ]; then
    echo "BUILD FAILED! Size is $FILESIZE; expected $EXPECTED_SIZE ($ROM_COUNT ROMs)"
    rm -f "$ONE_FILE"
    exit 1
fi

ROM_FOLDER="$MAME_ROM_DIR/$MAME_SYSTEM"
if [ ! -d "$ROM_FOLDER" ]; then
    echo "missing MAME ROM directory $ROM_FOLDER"
    rm -f "$ONE_FILE"
    exit 1
fi

echo "writing $ROM_COUNT ROMs with prefix $SRC_ROM_PREFIX"
for i in $(seq 1 "$ROM_COUNT"); do
    ROM_FILE="${SRC_ROM_PREFIX}_${i}.bin"
    dd if="$ONE_FILE" of="$ROM_FILE" bs="$ROM_SIZE" skip=$((i - 1)) count=1 status=none
    ROM_FILESIZE=$(wc -c < "$ROM_FILE")
    if [ "$ROM_FILESIZE" -ne "$ROM_SIZE" ]; then
        echo "BUILD FAILED! $ROM_FILE is $ROM_FILESIZE bytes; expected $ROM_SIZE"
        rm -f "$ONE_FILE"
        exit 1
    fi
done
rm -f "$ONE_FILE"

echo "deploying to MAME $MAME_SYSTEM as ${MAME_ROM_PREFIX}_*.bin"
for i in $(seq 1 "$ROM_COUNT"); do
    cp "${SRC_ROM_PREFIX}_${i}.bin" "$ROM_FOLDER/${MAME_ROM_PREFIX}_${i}.bin"
done
