#!/bin/bash

ASM_DIR="/Users/msw/dev/8085-Assembler/"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$SCRIPT_DIR" || exit 1
MAME_ROM_DIR="$SCRIPT_DIR/upstream/mame/roms"
ROM_SIZE=2048
ROM5_IMAGE_SLOT=5

if [ -z "$1" ]; then
    echo "Usage: $0 <source-game>"
    exit 1
fi

src_filename=$(basename -- "$1")
src_filename="${src_filename%.*}"
if [ -n "$2" ]; then
    echo "build now chooses its MAME target from rom_count; do not pass a destination"
    exit 1
fi

config=$(python3 "$SCRIPT_DIR/rom_config.py" "$src_filename") || exit $?
IFS=$'\t' read -r ROM_COUNT MAME_SYSTEM MAME_ROM_PREFIX SRC_ROM_PREFIX <<< "$config"
cd "$src_filename" || exit 1
FILE="$src_filename.asm"
ONE_FILE="$src_filename.bin"
if [ ! -f "$FILE" ]; then
    echo "File $FILE not found!"
    exit 1
fi

python3 "$ASM_DIR/src/assembler.py" "$FILE" -b -o "$ONE_FILE"
if [ $? -ne 0 ]; then
    echo "assembler failed"
    exit 1
fi

# The fifth physical ROM is decoded at $2800.  Preserve the CPU-visible
# $2000-$27ff gap in the assembled address image so labels remain addresses.
IMAGE_SLOTS=$ROM_COUNT
if [ "$ROM_COUNT" -eq 5 ]; then
    IMAGE_SLOTS=$((ROM_COUNT + 1))
fi
EXPECTED_SIZE=$((ROM_SIZE * IMAGE_SLOTS))
FILESIZE=$(wc -c < "$ONE_FILE")
if [ "$FILESIZE" -ne "$EXPECTED_SIZE" ]; then
    echo "BUILD FAILED! Size is $FILESIZE; expected $EXPECTED_SIZE (CPU address image for $ROM_COUNT ROMs)"
    rm -f "$ONE_FILE"
    exit 1
fi

if [ "$ROM_COUNT" -eq 5 ]; then
    if ! cmp -s <(dd if="$ONE_FILE" bs="$ROM_SIZE" skip=4 count=1 status=none) <(dd if=/dev/zero bs="$ROM_SIZE" count=1 status=none); then
        echo 'BUILD FAILED! $2000-$27ff must be 2048 zero-filled bytes before ROM 5'
        rm -f "$ONE_FILE"
        exit 1
    fi
fi

ROM_FOLDER="$MAME_ROM_DIR/$MAME_SYSTEM"
if [ ! -d "$ROM_FOLDER" ]; then
    echo "missing MAME ROM directory $ROM_FOLDER"
    rm -f "$ONE_FILE"
    exit 1
fi

echo "writing $ROM_COUNT ROMs with prefix $SRC_ROM_PREFIX"
# Remove stale generated ROMs above the declared count.  This is semantically
# important for the ROMulator: a leftover fifth image selects ROM mode instead
# of the four-ROM aperture mode.
for existing_rom in "${SRC_ROM_PREFIX}"_*.bin; do
    [ -e "$existing_rom" ] || continue
    suffix=${existing_rom#"${SRC_ROM_PREFIX}_"}
    rom_number=${suffix%.bin}
    case "$rom_number" in
        ''|*[!0-9]*) continue ;;
    esac
    if [ "$rom_number" -gt "$ROM_COUNT" ]; then
        rm -f -- "$existing_rom"
    fi
done
for i in $(seq 1 "$ROM_COUNT"); do
    ROM_FILE="${SRC_ROM_PREFIX}_${i}.bin"
    IMAGE_SLOT=$((i - 1))
    if [ "$ROM_COUNT" -eq 5 ] && [ "$i" -eq 5 ]; then
        IMAGE_SLOT=$ROM5_IMAGE_SLOT
    fi
    dd if="$ONE_FILE" of="$ROM_FILE" bs="$ROM_SIZE" skip="$IMAGE_SLOT" count=1 status=none
    ROM_FILESIZE=$(wc -c < "$ROM_FILE")
    if [ "$ROM_FILESIZE" -ne "$ROM_SIZE" ]; then
        echo "BUILD FAILED! $ROM_FILE is $ROM_FILESIZE bytes; expected $ROM_SIZE"
        rm -f "$ONE_FILE"
        exit 1
    fi
done
rm -f "$ONE_FILE"

echo "deploying to MAME $MAME_SYSTEM as ${MAME_ROM_PREFIX}_*.bin"
for i in $(seq 1 "$ROM_COUNT"); do
    cp "${SRC_ROM_PREFIX}_${i}.bin" "$ROM_FOLDER/${MAME_ROM_PREFIX}_${i}.bin"
done
