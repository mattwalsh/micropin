#!/bin/bash

DISASM_DIR="/Users/msw/dev/8085-Disassembler/"
ROM_SIZE=2048

if [ -z "$1" ]; then
    echo "Usage: $0 <game>"
    exit 1
fi

filename=$(basename -- "$1")
filename="${filename%.*}"
if [ ! -d "$filename" ]; then
    echo "no such game / directory $filename"
    exit 1
fi
if [ ! -f "$filename/rom_prefix" ]; then
    echo "missing the game's rom_prefix file"
    exit 1
fi

ROM_COUNT=4
if [ -f "$filename/rom_count" ]; then
    ROM_COUNT=$(tr -d '[:space:]' < "$filename/rom_count")
fi
case "$ROM_COUNT" in
    ''|*[!0-9]*) echo "invalid rom_count in $filename/rom_count: $ROM_COUNT"; exit 1 ;;
esac
if [ "$ROM_COUNT" -lt 1 ]; then
    echo "rom_count must be at least 1"
    exit 1
fi

ROM_PREFIX=$(tr -d '[:space:]' < "$filename/rom_prefix")
ONE_FILE="$filename/$filename.bin"
for i in $(seq 1 "$ROM_COUNT"); do
    ROM_FILE="$filename/${ROM_PREFIX}_${i}.bin"
    if [ ! -f "$ROM_FILE" ]; then
        echo "missing ROM $ROM_FILE"
        exit 1
    fi
    ROM_FILESIZE=$(wc -c < "$ROM_FILE")
    if [ "$ROM_FILESIZE" -ne "$ROM_SIZE" ]; then
        echo "ROM $ROM_FILE is $ROM_FILESIZE bytes; expected $ROM_SIZE"
        exit 1
    fi
done

for i in $(seq 1 "$ROM_COUNT"); do
    # ROM 5 is decoded at $2800, not immediately after ROM 4.  Materialize
    # the $2000-$27ff RAM hole as NOPs so the disassembly's offsets are the
    # actual CPU addresses.
    if [ "$ROM_COUNT" -eq 5 ] && [ "$i" -eq 5 ]; then
        dd if=/dev/zero bs="$ROM_SIZE" count=1 status=none
    fi
    cat "$filename/${ROM_PREFIX}_${i}.bin"
done > "$ONE_FILE"

SYMBOLS="symbols.yml"
if [ -f "$filename/symbols.yml" ]; then
    SYMBOLS+=",$filename/symbols.yml"
fi
python3 "$DISASM_DIR/matdasm.py" --symbols "$SYMBOLS" -i "$ONE_FILE" > "$filename/$filename.asm"
python3 "$DISASM_DIR/matdasm.py" --symbols "$SYMBOLS" --raw -i "$ONE_FILE" > "$filename/$filename.raw.asm"
python3 "$DISASM_DIR/matdasm.py" --symbols "$SYMBOLS" -w -a -i "$ONE_FILE" > "$filename/$filename.a.asm"
rm -f "$ONE_FILE"
